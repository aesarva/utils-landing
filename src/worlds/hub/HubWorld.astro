---
// Мир хаба: список карточек продуктов. Заголовок — h1, на 404 — h2 (там свой h1).
import type { Lang } from '../../lib/schema';
import type { ProductView } from '../../lib/products';
import { pagePath } from '../../lib/routes';
import { t } from '../../i18n';

interface Props {
  lang: Lang;
  products: ProductView[];
  /** Уровень заголовка мира: на странице ровно один h1. */
  heading?: 'h1' | 'h2';
}
const { lang, products, heading = 'h1' } = Astro.props;
const Heading = heading;
---

<section class="world">
  <Heading>{t(lang).hubTitle}</Heading>
  <ul>
    {
      products.map((p) => (
        <li>
          <a href={pagePath(lang, p.id)}>{p.name}</a>
          <p>{p.tagline[lang]}</p>
        </li>
      ))
    }
  </ul>
</section>

<style is:global>
  :root[data-world="hub"] {
    --shell-ink: #1c1c1e;
    --shell-ground: #f5f5f7;
    --shell-accent: #0a5bd8;
    --shell-font: system-ui, sans-serif;
  }
</style>

<style>
  .world {
    max-width: 40rem;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }
  ul {
    list-style: none;
    padding: 0;
  }
</style>
