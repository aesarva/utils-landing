---
// Мир хаба: список карточек продуктов.
import type { Lang } from '../../lib/schema';
import type { ProductView } from '../../lib/products';
import { pagePath } from '../../lib/routes';
import { t } from '../../i18n';

interface Props {
  lang: Lang;
  products: ProductView[];
}
const { lang, products } = Astro.props;
---

<section class="world">
  <h1>{t(lang).hubTitle}</h1>
  <ul>
    {
      products.map((p) => (
        <li>
          <a href={pagePath(lang, p.id)}>{p.name}</a>
          <p>{p.tagline[lang]}</p>
        </li>
      ))
    }
  </ul>
</section>

<style is:global>
  :root {
    --shell-ink: #1c1c1e;
    --shell-ground: #f5f5f7;
    --shell-accent: #0a5bd8;
    --shell-font: system-ui, sans-serif;
  }
</style>

<style>
  .world {
    max-width: 40rem;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }
  ul {
    list-style: none;
    padding: 0;
  }
</style>
