---
// Мир Lidless: стена эфирной студии ночью. Табличка ON AIR — кнопка (демо панели приложения),
// под ней клавиши сессий и режим крышки; слева имя, строка и студийные индикаторы батареи и нагрева;
// на столе закрытый ноутбук — «крышка закрыта, всё ещё в эфире». Красный — только эфир и кнопка.
import '@fontsource-variable/roboto-flex/standard.css';
import '@fontsource/sofia-sans-extra-condensed/700.css';
import '@fontsource/neucha/400.css';
import { Image } from 'astro:assets';
import type { Lang } from '../../lib/schema';
import type { ProductView } from '../../lib/products';
import { formatSize } from '../../lib/products';
import { t } from '../../i18n';
import studio from '../../../assets/plates/lidless-studio.png';
import icon from '../../../assets/plates/lidless-icon.png';
import safePhoto from '../../../assets/plates/lidless-safe-photo.png';
import shotTimer from '../../assets/products/lidless/panel-timer.png';
import shotTimerRu from '../../assets/products/lidless/panel-timer-ru.png';
import shotIndefinite from '../../assets/products/lidless/panel-indefinite.png';
import shotSafety from '../../../assets/plates/lidless-panel-safety.png';
import signPlate from '../../../assets/plates/lidless-sign.png';
import meterBattery from '../../../assets/plates/lidless-meter-battery.png';
import meterHeat from '../../../assets/plates/lidless-meter-heat.png';
import tape from '../../../assets/plates/lidless-tape.png';
import menubar from '../../assets/products/lidless/menubar-dark.png';
import { LIDLESS_COPY } from './copy';

interface Props {
  lang: Lang;
  product: ProductView;
}
const { lang, product } = Astro.props;
const d = t(lang);
const c = LIDLESS_COPY[lang];
const r = product.release;

/** Демо-сессия: выбрана 1 ч, на табличке 59:58. */
const ACTIVE_SESSION = 1;
const lines = (s: string) => s.split('\n');
const SHOTS = [
  { key: 'timer', src: lang === 'ru' ? shotTimerRu : shotTimer },
  { key: 'indefinite', src: shotIndefinite },
  { key: 'safety', src: shotSafety },
] as const;
---

<div class="ld">
  <section class="ld-hero" aria-labelledby="ld-title">
    <Image class="ld-studio" src={studio} alt="" widths={[1152, 1536, 2304]} sizes="100vw" loading="eager" fetchpriority="high" />

    <div class="ld-name">
      <Image class="ld-icon" src={icon} alt="" width={140} height={140} densities={[1, 2]} loading="eager" />
      <div>
        <h1 id="ld-title" class="ld-title">{product.name}</h1>
        <p class="ld-byline">{c.byline}</p>
      </div>
    </div>
    <p class="ld-headline">{product.tagline[lang]}</p>
    <p class="ld-lede">{c.lede}</p>

    <div class="ld-meters" aria-hidden="true">
      <div class="ld-meter ld-meter-battery">
        <Image src={meterBattery} alt="" width={262} densities={[1, 2]} loading="eager" />
        <span class="ld-meter-stop">20%</span>
        <span class="ld-meter-label">{c.battery}</span>
      </div>
      <div class="ld-meter ld-meter-heat">
        <Image src={meterHeat} alt="" width={282} densities={[1, 2]} loading="eager" />
        <span class="ld-meter-label">{c.heat}</span>
      </div>
    </div>

    <div class="ld-console">
      <button class="ld-sign" type="button" aria-pressed="true" aria-describedby="ld-sign-hint" data-sign>
        <Image class="ld-sign-plate" src={signPlate} alt="" widths={[690, 1380]} sizes="(min-width: 64rem) 45vw, 100vw" loading="eager" />
        <span class="ld-sign-word">{c.sign}</span>
        <span class="ld-sign-time" data-time>59:58</span>
      </button>
      <p id="ld-sign-hint" class="ld-hidden">{c.signHint}</p>

      <div class="ld-sessions" role="group" aria-label={c.sessionsLabel}>
        {
          c.sessions.map((s, i) => (
            <button type="button" aria-pressed={i === ACTIVE_SESSION ? 'true' : 'false'} data-session={i}>
              {s}
            </button>
          ))
        }
      </div>
      <button class="ld-closed-lid" type="button" aria-pressed="true" data-closed-lid>
        <svg viewBox="0 0 30 20" aria-hidden="true"><path d="M5 2.5h20v13H5zM1.5 17.5h27" /></svg>
        <span>{c.closedLid}</span>
      </button>

      <p class="ld-safety">{c.safety}</p>

      {
        r.status === 'released' ? (
          <div class="ld-dl" data-download>
            <a class="ld-download" href={r.url}>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 3.5v12M6.5 10l5.5 5.5 5.5-5.5M4.5 20h15" />
              </svg>
              <span>{c.download}</span>
            </a>
            <p class="ld-meta">
              v{r.version} · {formatSize(r.size, lang)} · {d.requires(product.requires.macos)} · {product.license}
            </p>
          </div>
        ) : (
          <div class="ld-dl">
            <p class="ld-soon">{d.comingSoon}</p>
            <p class="ld-meta">
              {d.requires(product.requires.macos)} · {product.license}
            </p>
          </div>
        )
      }
    </div>

    <p class="ld-caption">
      <Image class="ld-tape" src={tape} alt="" width={324} densities={[1, 2]} />
      <span>{c.caption}</span>
    </p>
  </section>

  <section class="ld-safe" aria-labelledby="ld-safe-title">
    <div class="ld-safe-text">
      <h2 id="ld-safe-title" class="ld-safe-title">{c.safeTitle}</h2>
      <p class="ld-safe-line">{c.safeLine}</p>
      <p class="ld-safe-body">{c.safeBody}</p>
    </div>
    <div class="ld-safe-card">
      <ul class="ld-safe-items">
        <li>
          <svg viewBox="0 0 30 20" aria-hidden="true"><path d="M2 3h23v14H2zM25 8h3v4h-3zM5 6h5v8H5z" /></svg>
          <span>{lines(c.safeItems.battery).map((l) => <span>{l}</span>)}</span>
        </li>
        <li>
          <svg viewBox="0 0 16 30" aria-hidden="true"><path d="M5.5 3a2.5 2.5 0 0 1 5 0v15.5a5 5 0 1 1-5 0zM8 11v12" /></svg>
          <span>{lines(c.safeItems.heat).map((l) => <span>{l}</span>)}</span>
        </li>
        <li>
          <svg viewBox="0 0 30 30" aria-hidden="true"><circle cx="15" cy="15" r="12.5" /><path d="M15 7.5V15l5 4" /></svg>
          <span>{lines(c.safeItems.time).map((l) => <span>{l}</span>)}</span>
        </li>
      </ul>
      <Image class="ld-safe-photo" src={safePhoto} alt="" widths={[606, 1212]} sizes="(min-width: 64rem) 40vw, 100vw" />
    </div>
  </section>

  <section class="ld-recover" aria-labelledby="ld-recover-title">
    <div class="ld-recover-main">
      <h2 id="ld-recover-title" class="ld-h2">{c.recoverTitle}</h2>
      <p class="ld-recover-lead">{c.recoverLead}</p>
      <table class="ld-recover-table">
        <thead>
          <tr><th scope="col">{c.recoverIf}</th><th scope="col">{c.recoverThen}</th></tr>
        </thead>
        <tbody>
          {c.recover.map(([when, then]) => <tr><td>{when}</td><td>{then}</td></tr>)}
        </tbody>
      </table>
    </div>
    <aside class="ld-security" aria-labelledby="ld-security-title">
      <h3 id="ld-security-title" class="ld-h3">{c.securityTitle}</h3>
      {
        c.security.map((x) => (
          <p>
            <strong>{x.title}</strong>
            <span>{x.text}</span>
          </p>
        ))
      }
    </aside>
  </section>

  <section class="ld-app" aria-labelledby="ld-app-title">
    <Image class="ld-app-wall" src={studio} alt="" widths={[1152, 2304]} sizes="100vw" />
    <h2 id="ld-app-title" class="ld-h2">{c.appTitle}</h2>
    <p class="ld-app-lead">{c.appLead}</p>
    <div class="ld-shots">
      {
        SHOTS.map((shot) => (
          <figure>
            <Image src={shot.src} alt={c.shots[shot.key]} widths={[320, 640]} sizes="(min-width: 64rem) 25vw, 80vw" />
            <figcaption>{c.shots[shot.key]}</figcaption>
          </figure>
        ))
      }
    </div>
    <figure class="ld-menubar">
      <Image src={menubar} alt={c.menubarAlt} width={536} densities={[1, 2]} />
      <figcaption>{c.menubarCaption}</figcaption>
    </figure>
  </section>

  <section class="ld-install" aria-labelledby="ld-install-title">
    <h2 id="ld-install-title" class="ld-h2">{c.installTitle}</h2>
    <div class="ld-install-body">
      <ol class="ld-steps">
        {
          c.steps.map((step, i) => (
            <li>
              <span class="ld-step-key" aria-hidden="true">{i + 1}</span>
              <span>{step}</span>
            </li>
          ))
        }
      </ol>
      <div class="ld-install-side">
        {
          r.status === 'released' ? (
            <a class="ld-download" href={r.url}>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 3.5v12M6.5 10l5.5 5.5 5.5-5.5M4.5 20h15" />
              </svg>
              <span>{c.download}</span>
            </a>
          ) : (
            <p class="ld-soon">{d.comingSoon}</p>
          )
        }
        <p class="ld-small">{d.requires(product.requires.macos)} · {c.signed}</p>
        <p class="ld-small">
          <a class="ld-source" href={`https://github.com/${product.repo}`}>{c.source}</a> · {d.license}: {product.license}
        </p>
      </div>
    </div>
  </section>
</div>

<script>
  import { startSign } from './motion';
  const console_ = document.querySelector<HTMLElement>('.ld-console');
  if (console_) startSign(console_);
</script>

<style is:global>
  :root[data-world='lidless'] {
    --shell-ink: #f4eee6;
    --shell-ground: #140c0a;
    --shell-accent: #e8302b;
    --shell-font: 'Roboto Flex Variable', system-ui, sans-serif;

    /* Единица компа: 1/1536 ширины на десктопе. */
    --u: calc(100vw / 1536);
    --night: #140c0a;
    --ink: #f4eee6;
    --ink-dim: #b9b0a8;
    --ink-faint: #8a8079;
    --on-air: #e8302b;
    --on-air-deep: #9e1712;
    --paper: #f9f6ef;
    --paper-ink: #151414;
    --paper-dim: #6d6a66;
    --text: 'Roboto Flex Variable', system-ui, sans-serif;
    --sign: 'Sofia Sans Extra Condensed', 'Roboto Flex Variable', sans-serif;
    --hand: 'Neucha', cursive;
  }

  :root[data-world='lidless'] body {
    background: var(--night);
    color: var(--ink);
    font-family: var(--text);
    font-size: calc(18 * var(--u));
    -webkit-font-smoothing: antialiased;
  }
  :root[data-world='lidless'] ::selection {
    background: var(--on-air);
    color: #fff;
  }
  :where(:root[data-world='lidless']) a {
    color: inherit;
  }
  :root[data-world='lidless'] :focus-visible {
    outline: max(calc(2 * var(--u)), 2px) solid var(--ink);
    outline-offset: calc(4 * var(--u));
  }
  :root[data-world='lidless'] .ld-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Верхняя строка лежит поверх фото студии. */
  :root[data-world='lidless'] .topbar {
    position: absolute;
    inset: 0 0 auto;
    z-index: 2;
    align-items: center;
    height: calc(55 * var(--u));
    padding: 0 calc(96 * var(--u)) 0 calc(100 * var(--u));
    box-sizing: border-box;
  }
  /* Линия под левой половиной строки. */
  :root[data-world='lidless'] .topbar::after {
    content: '';
    position: absolute;
    left: calc(95 * var(--u));
    width: calc(655 * var(--u));
    bottom: calc(5 * var(--u));
    height: 1px;
    background: rgb(244 238 230 / 0.16);
  }
  :root[data-world='lidless'] .hub-link {
    display: inline-flex;
    align-items: center;
    gap: calc(11 * var(--u));
    color: var(--ink);
    font-weight: 500;
    font-size: calc(17.5 * var(--u));
    text-decoration: none;
  }
  :root[data-world='lidless'] .hub-link::before {
    content: '←';
  }
  :root[data-world='lidless'] .lang-switch {
    font-size: calc(16 * var(--u));
    font-stretch: 80%;
    color: var(--ink);
  }
  :root[data-world='lidless'] .lang-switch a {
    color: inherit;
    text-decoration: none;
  }
  :root[data-world='lidless'] .lang-switch a:hover {
    color: var(--ink);
  }
  :root[data-world='lidless'] .lang-sep {
    margin: 0 0.18em;
  }
  :root[data-world='lidless'] .lang-current {
    color: var(--ink);
    font-weight: 700;
  }
  :root[data-world='lidless'] main {
    position: relative;
  }

  :root[data-world='lidless'] .footer {
    margin: 0;
    padding: calc(26 * var(--u)) calc(130 * var(--u)) calc(32 * var(--u));
    background: var(--night);
    color: var(--ink-faint);
    border-top: 1px solid rgb(244 238 230 / 0.1);
    font-size: calc(15 * var(--u));
  }
  :root[data-world='lidless'] .footer a {
    color: inherit;
    text-decoration: none;
  }
  :root[data-world='lidless'] .footer a:hover {
    color: var(--ink);
  }
  /* Телефон и узкий планшет: один поток, своя единица. */
  @media (max-width: 63.99rem) {
    :root[data-world='lidless'] {
      --u: calc(100vw / 620);
    }
    :root[data-world='lidless'] body {
      font-size: 16px;
    }
    :root[data-world='lidless'] .topbar {
      height: 52px;
      padding: 0 16px;
    }
    :root[data-world='lidless'] .topbar::after {
      left: 16px;
      right: 16px;
      width: auto;
      bottom: 0;
    }
    :root[data-world='lidless'] .hub-link,
    :root[data-world='lidless'] .lang-switch {
      font-size: 15px;
    }
    :root[data-world='lidless'] .footer {
      flex-direction: column;
      align-items: flex-start;
      padding: 22px 16px 28px;
      font-size: 14px;
    }
  }
</style>

<style>
  .ld-hero {
    position: relative;
    height: calc(795 * var(--u));
    overflow: hidden;
  }
  .ld-studio {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ld-hero > :not(.ld-studio) {
    position: absolute;
  }

  /* Имя: иконка, Lidless, подпись команды. */
  .ld-name {
    left: calc(133 * var(--u));
    top: calc(83 * var(--u));
    display: flex;
    gap: calc(33 * var(--u));
  }
  .ld-icon {
    width: calc(136 * var(--u));
    height: calc(136 * var(--u));
    margin: calc(2 * var(--u));
  }
  .ld-title {
    margin: calc(26 * var(--u)) 0 0;
    font-weight: 760;
    font-size: calc(100 * var(--u));
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-box: trim-both cap alphabetic;
  }
  .ld-byline {
    margin: calc(14 * var(--u)) 0 0;
    font-weight: 500;
    font-size: calc(21 * var(--u));
    color: #929291;
    text-box: trim-both cap alphabetic;
  }
  .ld-headline {
    left: calc(137 * var(--u));
    top: calc(247 * var(--u));
    width: calc(600 * var(--u));
    margin: 0;
    font-weight: 700;
    font-size: calc(56 * var(--u));
    line-height: calc(57 * var(--u));
    letter-spacing: -0.02em;
    color: var(--ink);
    text-wrap: balance;
    text-box: trim-both cap alphabetic;
  }
  .ld-lede {
    left: calc(138 * var(--u));
    top: calc(368 * var(--u));
    width: calc(612 * var(--u));
    margin: 0;
    font-size: calc(22 * var(--u));
    font-stretch: 78%;
    line-height: calc(29 * var(--u));
    color: var(--ink);
    text-box: trim-both cap alphabetic;
  }

  /* Студийные индикаторы: плиты с клёпаной рамой и сегментами, подписи — текстом. */
  .ld-meters {
    left: calc(190 * var(--u));
    top: calc(437 * var(--u));
    display: flex;
    gap: calc(20 * var(--u));
  }
  .ld-meter {
    position: relative;
  }
  .ld-meter img {
    display: block;
    width: 100%;
    height: auto;
  }
  .ld-meter-battery {
    width: calc(262 * var(--u));
  }
  .ld-meter-heat {
    width: calc(282 * var(--u));
  }
  /* «20%» над оранжевой стоп-линией плиты (36,8% ширины). */
  .ld-meter-stop {
    position: absolute;
    left: 36.8%;
    top: 36.5%;
    translate: -50% -110%;
    font: 600 calc(13 * var(--u)) / 1 var(--text);
    color: #f0a066;
  }
  .ld-meter-label {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 11%;
    font-size: calc(18.5 * var(--u));
    text-align: center;
    color: var(--ink);
  }
  /* Подпись нагрева в макете сдвинута вправо, к шкале. */
  .ld-meter-heat .ld-meter-label {
    left: calc(22 * var(--u));
  }

  /* Пульт справа: табличка, сессии, режим крышки, правила, скачивание. */
  .ld-console {
    left: calc(762 * var(--u));
    top: calc(72 * var(--u));
    width: calc(690 * var(--u));
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .ld-sign {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: calc(30 * var(--u));
    
    width: 100%;
    height: calc(236 * var(--u));
    padding: 0 0 0 calc(14 * var(--u));
    border: 0;
    border-radius: calc(14 * var(--u));
    cursor: pointer;
    font: inherit;
    color: #fff1d6;
    background: none;
    position: relative;
  }
  /* Корпус и стекло — плита; свечение уходит на стену вокруг. */
  .ld-sign-plate {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter:
      drop-shadow(0 0 calc(36 * var(--u)) rgb(232 48 43 / 0.45))
      drop-shadow(0 calc(30 * var(--u)) calc(50 * var(--u)) rgb(232 48 43 / 0.25));
  }
  /* Вне эфира стекло гаснет: дымчатый слой поверх стекла той же плиты. */
  .ld-sign::before {
    content: '';
    position: absolute;
    z-index: 1;
    inset: 9% 4.2% 11% 4.2%;
    border-radius: 2.5% / 8%;
    background: radial-gradient(ellipse at 50% 45%, #2a0907, #120403);
    opacity: 0;
  }
  .ld-sign-word,
  .ld-sign-time {
    z-index: 2;
  }
  /* Слово и отсчёт стоят по координатам таблички (линии прописных — по макету). */
  .ld-sign > * {
    position: absolute;
  }
  .ld-sign-word {
    left: calc(84 * var(--u));
    top: calc(75 * var(--u));
  }
  .ld-sign-time {
    left: calc(454 * var(--u));
    top: calc(87 * var(--u));
  }
  /* «В ЭФИРЕ» длиннее «ON AIR»: на русской табличке слово мельче, разделитель и отсчёт правее. */
  .ld-sign:lang(ru) .ld-sign-word {
    left: calc(54 * var(--u));
    top: calc(82 * var(--u));
    font-size: calc(124 * var(--u));
    letter-spacing: 0.01em;
  }
  .ld-sign:lang(ru) .ld-sign-time {
    left: calc(482 * var(--u));
    top: calc(92 * var(--u));
    font-size: calc(96 * var(--u));
  }
  .ld-sign:lang(ru)::after {
    left: calc(457 * var(--u));
  }
  .ld-safety:lang(ru),
  .ld-safe-line:lang(ru) {
    white-space: normal;
  }
  /* Разделитель между словом и отсчётом. */
  .ld-sign::after {
    content: '';
    position: absolute;
    left: calc(421 * var(--u));
    top: calc(66 * var(--u));
    width: calc(2 * var(--u));
    height: calc(110 * var(--u));
    z-index: 2;
    background: rgb(255 220 200 / 0.5);
  }
  .ld-sign[aria-pressed='false']::after {
    background: rgb(120 50 40 / 0.4);
  }
  .ld-sign-word,
  .ld-sign-time {
    font-family: var(--sign);
    font-weight: 700;
    line-height: 1;
    text-box: trim-both cap alphabetic;
    text-shadow:
      0 0 calc(12 * var(--u)) rgb(255 210 170 / 0.5),
      0 0 calc(2 * var(--u)) rgb(255 240 220 / 0.7);
  }
  .ld-sign-word {
    font-size: calc(142 * var(--u));
    letter-spacing: 0.035em;
  }
  .ld-sign-time {
    font-size: calc(104 * var(--u));
    letter-spacing: -0.02em;
  }
  /* Стекло загорается и гаснет за 180 мс, как лампа. */
  .ld-sign::before,
  .ld-sign-word,
  .ld-sign-time {
    transition:
      opacity 180ms ease-out,
      color 180ms ease-out,
      text-shadow 180ms ease-out;
  }
  @media (prefers-reduced-motion: reduce) {
    .ld-sign::before,
    .ld-sign-word,
    .ld-sign-time {
      transition: none;
    }
  }
