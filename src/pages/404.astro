---
// 404: мир хаба, тексты на обоих языках; язык по пути неизвестен.
import { loadProducts } from '../lib/load';
import { t } from '../i18n';
import { pagePath } from '../lib/routes';
import Shell from '../layouts/Shell.astro';
import HubWorld from '../worlds/hub/HubWorld.astro';

const products = await loadProducts();
const ru = t('ru');
const en = t('en');
---

<Shell lang="ru" title={`${ru.notFoundTitle} / ${en.notFoundTitle}`} description={ru.notFoundBody} isHub>
  <section>
    <h1>{ru.notFoundTitle}</h1>
    <p>{ru.notFoundBody} <a href={pagePath('ru')}>{ru.hub}</a></p>
    <h2>{en.notFoundTitle}</h2>
    <p>{en.notFoundBody} <a href={pagePath('en')}>{en.hub}</a></p>
  </section>
  <HubWorld lang="ru" products={products} />
</Shell>
