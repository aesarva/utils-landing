---
// Страница хаба: оболочка + шапка лейбла в верхней панели + каталог.
import type { Lang } from '../lib/schema';
import { loadProducts } from '../lib/load';
import { t } from '../i18n';
import Shell from '../layouts/Shell.astro';
import HubWorld from '../worlds/hub/HubWorld.astro';
import HubMasthead from '../worlds/hub/HubMasthead.astro';
import HubNavLinks from '../worlds/hub/HubNavLinks.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const products = await loadProducts();
const d = t(lang);
---

<Shell lang={lang} title={d.hubTitle} description={d.hubDescription} isHub>
  <HubMasthead slot="masthead" lang={lang} />
  <HubNavLinks slot="nav-links" lang={lang} />
  <HubWorld lang={lang} products={products} />
</Shell>
