---
// Переключатель языка «RU / EN»: текущий язык — текст, другой — ссылка на ту же страницу, без JS.
import type { Lang } from '../../lib/schema';
import { otherLang, pagePath } from '../../lib/routes';

interface Props {
  lang: Lang;
  productId?: string;
}
const { lang, productId } = Astro.props;
const other = otherLang(lang);
const code = (l: Lang) => l.toUpperCase();
const items = (['ru', 'en'] as const).map((l) => ({ l, current: l === lang }));
---

<span class="lang-switch">
  {
    items.map(({ l, current }, i) => (
      <>
        {i > 0 && <span class="lang-sep" aria-hidden="true"> / </span>}
        {current ? (
          <span class="lang-current" aria-current="true">{code(l)}</span>
        ) : (
          <a href={pagePath(other, productId)} hreflang={other} lang={other}>{code(other)}</a>
        )}
      </>
    ))
  }
</span>
