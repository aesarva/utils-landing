---
// Подвал: организация и ссылка на GitHub.
import type { Lang } from '../../lib/schema';
import { ORG } from '../../lib/site';
import { t } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<footer class="footer">
  <a href={ORG.github}>{t(lang).footerOrg}</a>
</footer>

<style>
  .footer {
    padding: 1.5rem;
  }
</style>
