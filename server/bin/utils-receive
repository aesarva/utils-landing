#!/usr/bin/env bash
# Приёмник релизов utils-landing. Вызывается ключом CI: ssh utils-deploy@сервер <sha> < сборка.tar.gz
# (authorized_keys: restrict,command="/usr/local/bin/utils-receive").
# Пустой stdin — откат: current переключается на новейший из лежащих релизов этого <sha>.
# Каждая выкладка — новый каталог releases/<sha>.<наносекунды>-<pid>; current переключается атомарно,
# поэтому повторная выкладка того же sha не оставляет current висячей.
# Коды: 0 — готово; 2 — плохой sha; 3 — пустой stdin, а релиза нет; 4 — архив больше лимита, битый или небезопасный
# (симлинки, хардлинки, устройства, fifo, sparse, абсолютные пути и «..»);
# 5 — в сборке нет index.html, en/index.html или 404.html; 6 — другая выкладка уже идёт (занят замок).
set -euo pipefail

ROOT=${UTILS_ROOT:-/srv/utils/site}
MAX=${UTILS_MAX_BYTES:-52428800}
# Лимит распакованного (сумма размеров файлов в архиве): сжатая «бомба» иначе забила бы общий с VPN диск.
UNPACK_MAX=${UTILS_MAX_UNPACKED:-209715200}
KEEP=5
SHA=${SSH_ORIGINAL_COMMAND:-${1:-}}

if [[ ! $SHA =~ ^[0-9a-f]{40}$ ]]; then
  echo "utils-receive: нужен sha коммита (40 hex), получено: '$SHA'" >&2
  exit 2
fi

RELEASES=$ROOT/releases
mkdir -p "$RELEASES"

UPLOAD=""
INCOMING=""
TMPLINK=""
LOCKDIR=""
cleanup() {
  [[ -n $UPLOAD ]] && rm -rf "$UPLOAD"
  [[ -n $INCOMING ]] && rm -rf "$INCOMING"
  [[ -n $TMPLINK ]] && rm -f "$TMPLINK"
  [[ -n $LOCKDIR ]] && rmdir "$LOCKDIR" 2>/dev/null
  return 0
}
trap cleanup EXIT

# Замок на всё: приём, проверка, переключение, откат, чистка. Занят — код 6.
if command -v flock > /dev/null 2>&1; then
  exec 9> "$ROOT/.lock"
  if ! flock -n 9; then
    echo "utils-receive: идёт другая выкладка" >&2
    exit 6
  fi
else
  # Запасной замок там, где нет flock (macOS в тестах): mkdir атомарен.
  if ! mkdir "$ROOT/.lock.d" 2> /dev/null; then
    echo "utils-receive: идёт другая выкладка" >&2
    exit 6
  fi
  LOCKDIR=$ROOT/.lock.d
fi

UPLOAD=$(mktemp "$ROOT/.upload-XXXXXX")
INCOMING=$(mktemp -d "$ROOT/.incoming-XXXXXX")

switch_current() {
  TMPLINK=$(mktemp -u "$ROOT/.current-XXXXXX")
  ln -s "releases/$1" "$TMPLINK"
  # GNU mv -T подменяет ссылку атомарно; там, где его нет (macOS в тестах), — ln -sfn.
  if ! mv -Tf "$TMPLINK" "$ROOT/current" 2> /dev/null; then
    rm -f "$TMPLINK"
    ln -sfn "releases/$1" "$ROOT/current"
  fi
  TMPLINK=""
}

prune() {
  local current n=0 d
  current=$(basename "$(readlink "$ROOT/current")")
  # скрытые каталоги пропускаются; сортировка по метке времени в имени, новейшие — первыми.
  while read -r d; do
    [[ -z $d || $d == "$current" ]] && continue
    n=$((n + 1))
    ((n < KEEP)) && continue
    rm -rf "${RELEASES:?}/$d"
  done < <(find "$RELEASES" -mindepth 1 -maxdepth 1 -type d ! -name '.*' | sed 's|.*/||' | sort -t. -k2,2r)
}

head -c $((MAX + 1)) > "$UPLOAD"
SIZE=$(wc -c < "$UPLOAD" | tr -d ' ')

if ((SIZE == 0)); then
  LATEST=$(find "$RELEASES" -mindepth 1 -maxdepth 1 -type d -name "$SHA.*" | sed 's|.*/||' | sort -t. -k2,2r | sed -n 1p)
  if [[ -z $LATEST ]]; then
    echo "utils-receive: архива нет, и релиза $SHA на сервере нет" >&2
    exit 3
  fi
  switch_current "$LATEST"
  prune
  echo "utils-receive: current → $LATEST (откат)"
  exit 0
fi

if ((SIZE > MAX)); then
  echo "utils-receive: архив больше $MAX байт" >&2
  exit 4
fi

# Проверка архива ДО распаковки: только обычные файлы и каталоги, без абсолютных путей и «..»,
# сумма размеров не больше лимита. Битый gzip/tar — тоже отказ.
if ! python3 - "$UPLOAD" "$UNPACK_MAX" << 'PY'
import sys, tarfile

path, limit = sys.argv[1], int(sys.argv[2])
total = 0
try:
    with tarfile.open(path, 'r:gz') as tf:
        for m in tf:
            name = m.name
            if not name or '\0' in name or name.startswith('/') or '..' in name.split('/'):
                sys.exit('небезопасный путь: %r' % name)
            if m.type not in (tarfile.REGTYPE, tarfile.AREGTYPE, tarfile.DIRTYPE):
                sys.exit('недопустимый тип члена архива: %r' % name)
            if m.sparse is not None or any(k.startswith('GNU.sparse') for k in m.pax_headers):
                sys.exit('sparse-файлы не принимаются: %r' % name)
            if m.isreg():
                total += m.size
                if total > limit:
                    sys.exit('распакованная сборка больше %d байт' % limit)
except SystemExit:
    raise
except Exception as e:
    sys.exit('архив не читается: %s' % e)
PY
then
  echo "utils-receive: архив отклонён" >&2
  exit 4
fi

if ! tar -xzf "$UPLOAD" -C "$INCOMING" --no-same-owner --no-same-permissions 2> /dev/null; then
  echo "utils-receive: архив не распаковался" >&2
  exit 4
fi
# Второй рубеж: после распаковки не должно быть ничего, кроме файлов и каталогов.
if [[ -n $(find "$INCOMING" ! -type f ! -type d -print -quit) ]]; then
  echo "utils-receive: в сборке есть не файлы и не каталоги" >&2
  exit 4
fi
for f in index.html en/index.html 404.html; do
  if [[ ! -f $INCOMING/$f || -L $INCOMING/$f ]]; then
    echo "utils-receive: в сборке нет index.html, en/index.html или 404.html" >&2
    exit 5
  fi
done

printf '%s %s\n' "$SHA" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$INCOMING/release.txt"
chmod -R a+rX "$INCOMING"
NAME=$SHA.$(python3 -c 'import time; print("%020d" % time.time_ns())')-$$
mv "$INCOMING" "$RELEASES/$NAME"
INCOMING=""
switch_current "$NAME"
prune
echo "utils-receive: current → $NAME"
