#!/usr/bin/env bash
# Приёмник релизов utils-landing. Вызывается ключом CI: ssh utils-deploy@сервер <sha> < сборка.tar.gz
# (authorized_keys: restrict,command="/usr/local/bin/utils-receive").
# Пустой stdin — откат: current переключается на новейший из лежащих релизов этого <sha>.
# Каждая выкладка — новый каталог releases/<sha>.<наносекунды>-<pid>; current переключается атомарно,
# поэтому повторная выкладка того же sha не оставляет current висячей.
# Архив проверяет и распаковывает один и тот же разборщик (python tarfile) за один проход: tar -x не вызывается,
# поэтому расхождения разборщиков (обычный файл с именем на «/», битый заголовок посередине) не протащат член мимо проверок.
# Коды: 0 — готово; 2 — плохой sha или нецелый срок; 3 — пустой stdin, а релиза нет; 4 — архив больше лимита, битый
# или небезопасный (симлинки, хардлинки, устройства, fifo, sparse, абсолютные пути и «..», имена длиннее 1024 байт,
# повторы имён, release.txt в любом регистре, раздутые или глобальные PAX-заголовки, ненулевые байты после последнего
# члена), либо распаковка не уложилась в UTILS_EXTRACT_TIMEOUT секунд (по умолчанию 120);
# 5 — в сборке нет index.html, en/index.html или 404.html; 6 — другая выкладка уже идёт (занят замок);
# 7 — загрузка не завершилась за UTILS_UPLOAD_TIMEOUT секунд (по умолчанию 300): замок не держится вечно.
set -euo pipefail
# Рабочий каталог вызывающего может быть недоступен (runuser из /root): GNU find тогда падает.
cd /
# Локаль клиента (sshd AcceptEnv LANG LC_*) не должна менять поведение: C.UTF-8, где она есть, иначе C.
# Кодировку имён в python отдельно задаёт -X utf8.
LOCALES=$(locale -a 2> /dev/null || true)
if grep -qiE '^c\.utf-?8$' <<< "$LOCALES"; then
  export LC_ALL=C.UTF-8
else
  export LC_ALL=C
fi
unset LOCALES

ROOT=${UTILS_ROOT:-/srv/utils/site}
MAX=${UTILS_MAX_BYTES:-52428800}
# Лимит распакованного (сумма байт, реально записанных в файлы): сжатая «бомба» иначе забила бы общий с VPN диск.
UNPACK_MAX=${UTILS_MAX_UNPACKED:-209715200}
# Общий срок приёма архива: живой клиент мог бы держать stdin открытым, а с ним и замок, бесконечно.
UPLOAD_TIMEOUT=${UTILS_UPLOAD_TIMEOUT:-300}
# Срок распаковки: глубокие пути и тысячи членов не должны держать замок дольше.
EXTRACT_TIMEOUT=${UTILS_EXTRACT_TIMEOUT:-120}
KEEP=5
SHA=${SSH_ORIGINAL_COMMAND:-${1:-}}

if [[ ! $SHA =~ ^[0-9a-f]{40}$ ]]; then
  echo "utils-receive: нужен sha коммита (40 hex), получено: '$SHA'" >&2
  exit 2
fi

if [[ ! $UPLOAD_TIMEOUT =~ ^[1-9][0-9]*$ ]]; then
  echo "utils-receive: UTILS_UPLOAD_TIMEOUT должен быть целым числом секунд, получено: '$UPLOAD_TIMEOUT'" >&2
  exit 2
fi
if [[ ! $EXTRACT_TIMEOUT =~ ^[1-9][0-9]*$ ]]; then
  echo "utils-receive: UTILS_EXTRACT_TIMEOUT должен быть целым числом секунд, получено: '$EXTRACT_TIMEOUT'" >&2
  exit 2
fi
# python3 нужен и для приёма с таймаутом, и для проверки с распаковкой архива.
if ! command -v python3 > /dev/null 2>&1; then
  echo "utils-receive: нет python3 для приёма и распаковки архива" >&2
  exit 4
fi

RELEASES=$ROOT/releases
# Права явно, а не от umask: nginx должен читать релизы.
install -d -m 755 "$RELEASES"

UPLOAD=""
INCOMING=""
TMPLINK=""
LOCKDIR=""
cleanup() {
  [[ -n $UPLOAD ]] && rm -rf "$UPLOAD"
  [[ -n $INCOMING ]] && rm -rf "$INCOMING"
  [[ -n $TMPLINK ]] && rm -f "$TMPLINK"
  [[ -n $LOCKDIR ]] && rmdir "$LOCKDIR" 2>/dev/null
  return 0
}
trap cleanup EXIT

# Замок на всё: приём, проверка, переключение, откат, чистка. Занят — код 6.
if command -v flock > /dev/null 2>&1; then
  exec 9> "$ROOT/.lock"
  if ! flock -n 9; then
    echo "utils-receive: идёт другая выкладка" >&2
    exit 6
  fi
else
  # Запасной замок там, где нет flock (macOS в тестах): mkdir атомарен.
  if ! mkdir "$ROOT/.lock.d" 2> /dev/null; then
    echo "utils-receive: идёт другая выкладка" >&2
    exit 6
  fi
  LOCKDIR=$ROOT/.lock.d
fi

# Остатки запуска, убитого SIGKILL: замок наш, значит, они ничьи.
find "$ROOT" -mindepth 1 -maxdepth 1 \( -name '.upload-*' -o -name '.incoming-*' -o -name '.current-*' \) -exec rm -rf {} +

UPLOAD=$(mktemp "$ROOT/.upload-XXXXXX")
INCOMING=$(mktemp -d "$ROOT/.incoming-XXXXXX")

switch_current() {
  TMPLINK=$(mktemp -u "$ROOT/.current-XXXXXX")
  ln -s "releases/$1" "$TMPLINK"
  # GNU mv -T подменяет ссылку атомарно; там, где его нет (macOS в тестах), — ln -sfn.
  if ! mv -Tf "$TMPLINK" "$ROOT/current" 2> /dev/null; then
    rm -f "$TMPLINK"
    ln -sfn "releases/$1" "$ROOT/current"
  fi
  TMPLINK=""
}

prune() {
  local current n=0 d
  current=$(basename "$(readlink "$ROOT/current")")
  # скрытые каталоги пропускаются; сортировка по метке времени в имени, новейшие — первыми.
  while read -r d; do
    [[ -z $d || $d == "$current" ]] && continue
    n=$((n + 1))
    ((n < KEEP)) && continue
    rm -rf "${RELEASES:?}/$d"
  done < <(find "$RELEASES" -mindepth 1 -maxdepth 1 -type d ! -name '.*' | sed 's|.*/||' | sort -t. -k2,2r)
}

# Приём через python3: общий срок UPLOAD_TIMEOUT и лимит сжатого размера MAX.
# stdin (архив) передаётся в fd 3, потому что stdin python занят текстом скрипта.
# Коды python: 0 — принят целиком; 7 — срок вышел; 8 — больше MAX.
UPLOAD_RC=0
python3 -I -X utf8 - "$UPLOAD" "$MAX" "$UPLOAD_TIMEOUT" 3<&0 << 'PY' || UPLOAD_RC=$?
import os, select, sys, time

path, cap, timeout = sys.argv[1], int(sys.argv[2]), float(sys.argv[3])
deadline = time.monotonic() + timeout
total = 0
with open(path, 'wb') as out:
    while True:
        left = deadline - time.monotonic()
        if left <= 0:
            sys.exit(7)
        ready, _, _ = select.select([3], [], [], left)
        if not ready:
            sys.exit(7)
        chunk = os.read(3, 1 << 16)
        if not chunk:
            break
        total += len(chunk)
        if total > cap:
            sys.exit(8)
        out.write(chunk)
PY
case $UPLOAD_RC in
  0) ;;
  7)
    echo "utils-receive: загрузка не завершилась за $UPLOAD_TIMEOUT с" >&2
    exit 7
    ;;
  8)
    echo "utils-receive: архив больше $MAX байт" >&2
    exit 4
    ;;
  *)
    echo "utils-receive: архив не принят (python3 вернул $UPLOAD_RC)" >&2
    exit 4
    ;;
esac
SIZE=$(wc -c < "$UPLOAD" | tr -d ' ')

if ((SIZE == 0)); then
  LATEST=$(find "$RELEASES" -mindepth 1 -maxdepth 1 -type d -name "$SHA.*" | sed 's|.*/||' | sort -t. -k2,2r | sed -n 1p)
  if [[ -z $LATEST ]]; then
    echo "utils-receive: архива нет, и релиза $SHA на сервере нет" >&2
    exit 3
  fi
  switch_current "$LATEST"
  prune
  echo "utils-receive: current → $LATEST (откат)"
  exit 0
fi

# Проверка и распаковка — один проход одного разборщика: python tarfile в потоковом режиме читает распакованный
# gzip-поток и сам пишет на диск ровно те члены, которые проверил; tar -x не вызывается.
# Правила: только обычные файлы и каталоги; без абсолютных путей, «..», пустых имён, NUL, имён длиннее 1024 байт
# и глубже 32 компонентов; без release.txt в любом регистре (его пишет приёмник); обычный файл с именем на «/»,
# отрицательный размер и повтор имени (файла или каталога) — отказ.
# Служебные заголовки tarfile читает целиком в память до любых проверок, поэтому у них свой бюджет: PAX-заголовок
# члена — не больше 64 КиБ, длинное имя GNU — не больше 1024 байт, глобальные PAX-заголовки (копируются в каждый
# следующий член) и sparse — отказ ещё до чтения их данных. Подстраховка — RLIMIT_AS 512 МиБ (где он работает).
# Каталоги создаются по одному компоненту относительно дескриптора родителя (O_DIRECTORY|O_NOFOLLOW),
# файлы — O_CREAT|O_EXCL|O_NOFOLLOW: симлинк или уже существующий путь — отказ, а не запись мимо staging.
# Права ставятся сразу при создании (umask 022): каталоги 755, файлы 644.
# Лимиты: записанные байты плюс 4096 за каждый созданный файл и каталог (блок на диске, в том числе у неявных
# каталогов) — не больше UNPACK_MAX; членов вместе с неявными каталогами — не больше 20000; распакованный поток —
# не больше UNPACK_MAX + 1 МиБ.
# Срок EXTRACT_TIMEOUT: SIGALRM завершает python сразу (os._exit), даже посреди долгого разбора заголовка gzip;
# снаружи, где есть GNU timeout (сервер), python добивается SIGKILL через 5 с после срока.
# Конец архива: от конца данных последнего принятого члена до конца потока допустимы только нули. Так битый
# или отброшенный tarfile заголовок (он принял бы его за конец архива) не пройдёт молча.
# Последним создаётся release.txt (O_EXCL: вариант имени в другом регистре на macOS — отказ, а не перезапись).
# Коды: 0 — распакован; 9 — срок вышел (124/137 — убит внешним timeout); остальное — отказ (причина в stderr).
EXTRACT_RC=0
STAMP="$SHA $(date -u +%Y-%m-%dT%H:%M:%SZ)"
HARD_KILL=()
if command -v timeout > /dev/null 2>&1; then
  HARD_KILL=(timeout --signal=KILL $((EXTRACT_TIMEOUT + 5)))
fi
${HARD_KILL[@]+"${HARD_KILL[@]}"} python3 -I -X utf8 - "$UPLOAD" "$INCOMING" "$UNPACK_MAX" "$EXTRACT_TIMEOUT" "$STAMP" << 'PY' || EXTRACT_RC=$?
import os, signal, sys

# Срок — первым делом: обработчик выходит сразу, не дожидаясь, пока код вернётся в цикл.
signal.signal(signal.SIGALRM, lambda *_: os._exit(9))
signal.alarm(int(sys.argv[4]))

import gzip, tarfile

# Подстраховка по памяти: адресное пространство не больше 512 МиБ (на macOS RLIMIT_AS не ставится — пропуск).
try:
    import resource
    resource.setrlimit(resource.RLIMIT_AS, (512 << 20, 512 << 20))
except (ImportError, ValueError, OSError):
    pass

path, dest, limit, stamp = sys.argv[1], sys.argv[2], int(sys.argv[3]), sys.argv[5]
MAX_ENTRIES = 20000
MAX_NAME = 1024
MAX_DEPTH = 32
# Плата за каждый созданный файл или каталог: блок на диске, которого нет в размере данных.
ENTRY_COST = 4096
MAX_EXT = 64 * 1024
CHUNK = 1 << 16
# Сколько последних байт потока помнить: после последнего члена tarfile читает не больше служебного заголовка
# (до MAX_EXT), самого заголовка и записи вперёд (10 КиБ).
TAIL = 1 << 20
DIR_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
FILE_FLAGS = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW
os.umask(0o022)


def show(s):
    """Имя или текст ошибки для сообщения: не больше 200 символов, чтобы не раздувать stderr и лог CI."""
    s = str(s)
    return repr(s[:200]) + ('…' if len(s) > 200 else '')


class Guarded(tarfile.TarInfo):
    """Заголовок с бюджетом на служебные записи: проверка — до того, как tarfile прочтёт их данные в память."""

    def _proc_member(self, tf):
        if self.size < 0:
            raise tarfile.ReadError('отрицательный размер члена')
        if self.type == tarfile.XGLTYPE:
            raise tarfile.ReadError('глобальные PAX-заголовки не принимаются')
        if self.type in (tarfile.XHDTYPE, tarfile.SOLARIS_XHDTYPE) and self.size > MAX_EXT:
            raise tarfile.ReadError('PAX-заголовок больше %d байт' % MAX_EXT)
        if self.type in (tarfile.GNUTYPE_LONGNAME, tarfile.GNUTYPE_LONGLINK) and self.size > MAX_NAME + 1:
            raise tarfile.ReadError('длинное имя GNU больше %d байт' % MAX_NAME)
        if self.type == tarfile.GNUTYPE_SPARSE:
            raise tarfile.ReadError('sparse-файлы не принимаются')
        return super()._proc_member(tf)

    # Карты sparse из PAX (форматы 0.0, 0.1, 1.0) строятся в памяти до того, как член виден циклу.
    def _proc_gnusparse_00(self, *args):
        raise tarfile.ReadError('sparse-файлы не принимаются')

    _proc_gnusparse_01 = _proc_gnusparse_10 = _proc_gnusparse_00


class Capped:
    """Читает распакованный поток не дальше cap байт (превышение — исключение до выделения лишнего)
    и помнит хвост отданного: по нему проверяется всё, что лежит после последнего члена."""

    def __init__(self, f, cap):
        self.f, self.left, self.pos, self.tail = f, cap, 0, bytearray()

    def read(self, n=-1):
        want = self.left + 1 if n is None or n < 0 else min(n, self.left + 1)
        data = self.f.read(want)
        if len(data) > self.left:
            raise ValueError('распакованный поток больше лимита')
        self.left -= len(data)
        self.pos += len(data)
        self.tail += data
        if len(self.tail) > 2 * TAIL:
            del self.tail[:-TAIL]
        return data


entries = 0
written = 0


def bump():
    """Член архива или неявно созданный каталог: и то и другое занимает место, лимит общий."""
    global entries
    entries += 1
    if entries > MAX_ENTRIES:
        sys.exit('слишком много членов архива (вместе с неявными каталогами больше %d)' % MAX_ENTRIES)


def charge(n):
    """n байт на диск (данные или ENTRY_COST за созданную запись); сверх лимита — отказ сразу."""
    global written
    written += n
    if written > limit:
        sys.exit('распакованная сборка больше %d байт (с учётом %d байт на файл и каталог)' % (limit, ENTRY_COST))


def parts_of(name):
    """Компоненты пути без пустых и «.»; небезопасное имя — отказ."""
    if not name or '\0' in name or name.startswith('/'):
        sys.exit('небезопасный путь: %s' % show(name))
    if len(name.encode('utf-8', 'surrogateescape')) > MAX_NAME:
        sys.exit('имя длиннее %d байт: %s' % (MAX_NAME, show(name)))
    parts = [p for p in name.split('/') if p not in ('', '.')]
    if '..' in parts:
        sys.exit('небезопасный путь: %s' % show(name))
    if len(parts) > MAX_DEPTH:
        sys.exit('путь глубже %d компонентов: %s' % (MAX_DEPTH, show(name)))
    return parts


def open_dir(parts):
    """Дескриптор каталога dest/parts; недостающие каталоги создаются (755). Симлинк или файл
    на пути не открывается (ELOOP/ENOTDIR) — исключение, то есть отказ."""
    fd = os.open(dest, DIR_FLAGS)
    try:
        for p in parts:
            try:
                os.mkdir(p, 0o755, dir_fd=fd)
                bump()
                charge(ENTRY_COST)
            except FileExistsError:
                pass
            nfd = os.open(p, DIR_FLAGS, dir_fd=fd)
            os.close(fd)
            fd = nfd
    except BaseException:
        os.close(fd)
        raise
    return fd


def make_dir(parts):
    """Каталог-член; уже созданный неявно (файлами внутри него) — допустим."""
    if not parts:
        return
    fd = open_dir(parts[:-1])
    try:
        try:
            os.mkdir(parts[-1], 0o755, dir_fd=fd)
            charge(ENTRY_COST)
        except FileExistsError:
            pass
        os.close(os.open(parts[-1], DIR_FLAGS, dir_fd=fd))
    finally:
        os.close(fd)


def create(parts):
    """Новый файл dest/parts (O_EXCL, 644): существующий путь в любом регистре — исключение."""
    fd = open_dir(parts[:-1])
    try:
        out = os.open(parts[-1], FILE_FLAGS, 0o644, dir_fd=fd)
    finally:
        os.close(fd)
    os.fchmod(out, 0o644)
    return out


def write_all(out, data):
    view = memoryview(data)
    while view:
        view = view[os.write(out, view):]


def write_file(tf, m, parts):
    """Файл-член: копируется ровно m.size байт; записанное сразу идёт в лимит."""
    # Заявленный размер сверх лимита — отказ до создания файла (запись всё равно считается по факту).
    if written + ENTRY_COST + m.size > limit:
        sys.exit('распакованная сборка больше %d байт (с учётом %d байт на файл и каталог)' % (limit, ENTRY_COST))
    out = create(parts)
    charge(ENTRY_COST)
    try:
        src = tf.extractfile(m)
        left = m.size
        while left > 0:
            chunk = src.read(min(CHUNK, left))
            if not chunk:
                sys.exit('член архива обрывается: %s' % show(m.name))
            charge(len(chunk))
            write_all(out, chunk)
            left -= len(chunk)
    finally:
        os.close(out)


try:
    with gzip.open(path, 'rb') as gz:
        stream = Capped(gz, limit + 1024 * 1024)
        tf = tarfile.open(fileobj=stream, mode='r|', tarinfo=Guarded, encoding='utf-8', errors='surrogateescape')
        seen = set()
        # Позиция, где кончаются данные последнего принятого члена (с выравниванием до 512).
        end = 0
        while True:
            m = tf.next()
            # Python 3.9 копит все TarInfo в tf.members и в потоковом режиме: держим не больше одного.
            tf.members.clear()
            if m is None:
                break
            bump()
            name = m.name
            parts = parts_of(name)
            if parts and parts[0].casefold() == 'release.txt':
                sys.exit('release.txt пишет только приёмник: %s' % show(name))
            if m.type not in (tarfile.REGTYPE, tarfile.AREGTYPE, tarfile.DIRTYPE):
                sys.exit('недопустимый тип члена архива: %s' % show(name))
            if m.sparse is not None or any(k.startswith('GNU.sparse') for k in m.pax_headers):
                sys.exit('sparse-файлы не принимаются: %s' % show(name))
            if m.size < 0:
                sys.exit('отрицательный размер члена: %s' % show(name))
            key = '/'.join(parts)
            if key in seen:
                sys.exit('повтор имени в архиве: %s' % show(name))
            seen.add(key)
            if m.isdir():
                if m.size:
                    sys.exit('каталог с данными: %s' % show(name))
                make_dir(parts)
            else:
                # «pad/», «q/.» и «.» — имена каталога у обычного файла.
                if not parts or name.split('/')[-1] in ('', '.'):
                    sys.exit('обычный файл с именем каталога: %s' % show(name))
                write_file(tf, m, parts)
            end = m.offset_data + (m.size + 511) // 512 * 512
        # tarfile кончает архив на нулевом блоке, но и на битом заголовке или обрыве, а заголовок с негодным
        # PAX-размером может молча отбросить. Поэтому граница — не его позиция, а конец данных последнего
        # принятого члена: всё дальше (блоки конца, остаток записи) должно быть нулями.
        start = stream.pos - len(stream.tail)
        if not start <= end <= stream.pos:
            sys.exit('не удалось проверить конец архива')
        rest = bytes(stream.tail[end - start:])
        while True:
            if rest.count(0) != len(rest):
                sys.exit('после последнего члена архива есть данные, кроме нулей')
            rest = stream.read(CHUNK)
            if not rest:
                break
    out = create(['release.txt'])
    try:
        write_all(out, (stamp + '\n').encode())
    finally:
        os.close(out)
    signal.alarm(0)
except SystemExit:
    raise
except MemoryError:
    sys.exit('архиву не хватило памяти')
except Exception as e:
    sys.exit('архив не читается или не распаковывается: %s' % show(e))
PY
case $EXTRACT_RC in
  0) ;;
  9 | 124 | 137)
    echo "utils-receive: распаковка не завершилась за $EXTRACT_TIMEOUT с" >&2
    exit 4
    ;;
  *)
    echo "utils-receive: архив отклонён" >&2
    exit 4
    ;;
esac
# Второй рубеж: после распаковки не должно быть ничего, кроме файлов и каталогов; сбой самого find — тоже отказ.
if ! BAD=$(find "$INCOMING" ! -type f ! -type d -print -quit 2> /dev/null) || [[ -n $BAD ]]; then
  echo "utils-receive: в сборке есть не файлы и не каталоги" >&2
  exit 4
fi
for f in index.html en/index.html 404.html; do
  if [[ ! -f $INCOMING/$f || -L $INCOMING/$f ]]; then
    echo "utils-receive: в сборке нет index.html, en/index.html или 404.html" >&2
    exit 5
  fi
done

# nginx читает релиз: содержимое уже 755/644 с распаковки, сам каталог из mktemp — 700.
chmod 755 "$INCOMING"
NAME=$SHA.$(python3 -I -X utf8 -c 'import time; print("%020d" % time.time_ns())')-$$
mv "$INCOMING" "$RELEASES/$NAME"
INCOMING=""
switch_current "$NAME"
prune
echo "utils-receive: current → $NAME"
