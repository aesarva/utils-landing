{
  "name": "utils-landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Лендинг утилит CyberTech для macOS: utils.cyber-tech.online",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run fetch:releases && tsx scripts/validate.ts && astro build",
